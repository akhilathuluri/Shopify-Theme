<section class="alpina-page-section full-width">
  <div class="alpina-container">
    <div class="alpina-page-card alpina-card">
      <header class="page-header">
        <h1 class="page-title">{{ page.title }}</h1>
      </header>
      <div class="page-content rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .alpina-page-section {
    background-color: var(--color-bg-primary, #D4F1E0);
    padding-top: 3.5rem;
    padding-bottom: 6rem;
  }
  .alpina-page-card {
    max-width: 860px;
    margin: 0 auto;
    padding: 3.5rem 3rem;
    background-color: #FFFFFF;
  }
  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(12, 74, 52, 0.1);
  }
  .page-title {
    font-size: clamp(2.2rem, 3.5vw + 0.5rem, 3.2rem);
    color: var(--color-headings, #0C4A34);
  }
  .page-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text, #1B3B2B);
  }
  .page-content p {
    margin-bottom: 1.5rem;
  }
  .page-content h2, .page-content h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-headings, #0C4A34);
  }

  @media screen and (max-width: 640px) {
    .alpina-page-card {
      padding: 2.2rem 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Standard Page",
  "settings": []
}
{% endschema %}
