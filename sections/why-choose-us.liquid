{%- liquid
  assign bg_color = section.settings.bg_color | default: 'var(--color-bg-alternate)'
  assign text_color = section.settings.text_color | default: 'var(--color-text)'
  assign heading_color = section.settings.heading_color | default: 'var(--color-headings)'
-%}

<section
  class="why-choose-us full-width"
  style="
    --wcu-bg: {{ bg_color }};
    --wcu-text: {{ text_color }};
    --wcu-heading: {{ heading_color }};
    --wcu-pt: {{ section.settings.padding_top }}px;
    --wcu-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="alpina-container">
    <div class="why-grid{% if section.settings.image_position == 'right' %} why-grid--reverse{% endif %}">
      <!-- Media Col -->
      <div class="why-media-col">
        <div class="why-media-frame alpina-card">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 800
              | image_tag:
                class: 'why-img',
                widths: '360, 540, 720, 800',
                loading: 'lazy',
                alt: section.settings.title
            }}
          {%- else -%}
            <div class="why-placeholder">
              <img src="{{ 'tea-illustration.svg' | asset_url }}" alt="" width="360" height="360" loading="lazy">
            </div>
          {%- endif -%}

          <div class="why-floating-badge">
            <span class="badge-number">6,200</span>
            <span class="badge-unit">Feet Altitude</span>
          </div>
        </div>
      </div>

      <!-- Text Content Col -->
      <div class="why-content-col">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="why-heading">{{ section.settings.title }}</h2>
        <div class="why-body">
          {{ section.settings.content }}
        </div>

        <div class="why-highlights">
          {%- for block in section.blocks -%}
            <div class="highlight-row" {{ block.shopify_attributes }}>
              <span class="highlight-check">{% render 'icon', name: 'check' %}</span>
              <div class="highlight-text">
                <strong>{{ block.settings.heading }}:</strong> {{ block.settings.description }}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div class="why-action">
            <a href="{{ section.settings.button_link }}" class="btn btn--primary">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .why-choose-us {
    background-color: var(--wcu-bg, var(--color-bg-alternate));
    color: var(--wcu-text, var(--color-text));
    padding-top: var(--wcu-pt, 80px);
    padding-bottom: var(--wcu-pb, 80px);
  }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: 4.5rem;
  }
  .why-grid--reverse {
    grid-template-columns: 1.1fr 1fr;
  }
  .why-grid--reverse .why-media-col {
    order: 2;
  }
  .why-media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3.5;
    background-color: var(--color-bg-primary, #D4F1E0);
    overflow: visible;
  }
  .why-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-card, 16px);
  }
  .why-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .why-floating-badge {
    position: absolute;
    bottom: -1.5rem;
    right: -1.5rem;
    background-color: var(--color-accent, #D97736);
    color: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    padding: 1.2rem 1.6rem;
    box-shadow: 0 10px 25px rgba(217, 119, 54, 0.35);
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
  }
  .badge-number {
    font-size: 1.8rem;
    font-weight: 800;
  }
  .badge-unit {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .why-heading {
    font-size: clamp(2rem, 3.2vw + 0.5rem, 3rem);
    color: var(--wcu-heading, var(--color-headings));
    line-height: 1.2;
    margin-bottom: 1.2rem;
  }
  .why-body {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--wcu-text, var(--color-text-muted));
    margin-bottom: 2rem;
  }
  .why-highlights {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: 2.2rem;
  }
  .highlight-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .highlight-check {
    width: 1.4rem;
    height: 1.4rem;
    min-width: 1.4rem;
    border-radius: 50%;
    background-color: var(--color-btn-bg, #00BFA5);
    color: #0C3827;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.2rem;
  }
  .highlight-check svg {
    width: 0.85rem;
    height: 0.85rem;
  }
  .highlight-text strong {
    color: var(--color-primary, #0C4A34);
  }
  .why-action {
    margin-top: 1rem;
  }

  @media screen and (max-width: 1023px) {
    .why-grid, .why-grid--reverse {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .why-grid--reverse .why-media-col {
      order: 0;
    }
    .why-floating-badge {
      bottom: -1rem;
      right: 0.5rem;
      padding: 0.8rem 1.2rem;
    }
    .badge-number {
      font-size: 1.4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ANCIENT TRADITIONS & LIVING FORESTS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Alpina Brew Elevates Your Daily Teatime"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Story Content",
      "default": "<p>Nestled where glacial streams meet cloud forests, Alpina Brew partners with multi-generational mountain tea growers. We eschew industrial mechanization, hand-selecting exclusively whole leaves picked at morning dew for peak aromatic density.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "READ OUR ESTATE JOURNAL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#EBF7EE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0C4A34"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1B3B2B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Key Highlight",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Unadulterated Botanicals"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short note",
          "default": "Zero synthetic flavourings, artificial perfumes, or mass fillers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "heading": "Unadulterated Botanicals",
            "description": "Pure unadulterated whole leaves with no synthetic flavourings or preservatives."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "heading": "Peak Elevation Terroir",
            "description": "Rich mineral volcanic soil and cool alpine night air cultivate unmatched natural sweetness."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "heading": "Airtight Oxygen Protection",
            "description": "Nitrogen-flushed vacuum sealed at the estate to guarantee crisp cellar notes."
          }
        }
      ]
    }
  ]
}
{% endschema %}
