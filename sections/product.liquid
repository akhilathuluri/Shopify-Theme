{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image
  assign bg_color = section.settings.bg_color | default: 'var(--color-bg-primary)'
  assign text_color = section.settings.text_color | default: 'var(--color-text)'
  assign heading_color = section.settings.heading_color | default: 'var(--color-headings)'
-%}

<section
  class="main-product full-width"
  style="
    --pdp-bg: {{ bg_color }};
    --pdp-text: {{ text_color }};
    --pdp-heading: {{ heading_color }};
    --pdp-pt: {{ section.settings.padding_top }}px;
    --pdp-pb: {{ section.settings.padding_bottom }}px;
  "
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="alpina-container pdp-container">
    <!-- Breadcrumb -->
    <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="breadcrumb-sep">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="breadcrumb-sep">/</span>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">Teas</a>
        <span class="breadcrumb-sep">/</span>
      {%- endif -%}
      <span class="breadcrumb-current">{{ product.title }}</span>
    </nav>

    <div class="pdp-grid">
      <!-- Media Gallery Column -->
      <div class="pdp-gallery-col">
        <div class="pdp-gallery-sticky">
          <!-- Main Display Image -->
          <div class="pdp-main-image-frame alpina-card">
            {%- if featured_image != blank -%}
              {{
                featured_image
                | image_url: width: 1000
                | image_tag:
                  id: 'PdpMainImage',
                  class: 'pdp-main-img',
                  widths: '400, 600, 800, 1000',
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: product.title
              }}
            {%- else -%}
              <div class="product-card-placeholder">
                <img src="{{ 'tea-illustration.svg' | asset_url }}" alt="" width="300" height="300" loading="eager">
              </div>
            {%- endif -%}

            <!-- Badges -->
            <div class="product-card-badges">
              {%- if product.available == false -%}
                <span class="alpina-badge alpina-badge--sold-out">SOLD OUT</span>
              {%- elsif product.compare_at_price > product.price -%}
                <span class="alpina-badge alpina-badge--sale">SALE</span>
              {%- endif -%}
              {%- if product.tags contains 'organic' or product.tags contains 'Organic' -%}
                <span class="alpina-badge alpina-badge--organic">100% ORGANIC</span>
              {%- endif -%}
            </div>
          </div>

          <!-- Thumbnails Row -->
          {%- if product.images.size > 1 -%}
            <div class="pdp-thumbnails-row">
              {%- for image in product.images -%}
                <button
                  type="button"
                  class="pdp-thumb-btn{% if image == featured_image %} pdp-thumb-btn--active{% endif %}"
                  data-thumbnail-src="{{ image | image_url: width: 1000 }}"
                  aria-label="View tea image {{ forloop.index }}"
                >
                  {{
                    image
                    | image_url: width: 160
                    | image_tag:
                      class: 'pdp-thumb-img',
                      widths: '100, 160',
                      loading: 'lazy',
                      alt: product.title
                  }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Product Form & Details Column -->
      <div class="pdp-details-col">
        {%- if product.vendor != blank -%}
          <div class="pdp-vendor">{{ product.vendor }}</div>
        {%- endif -%}

        <h1 class="pdp-title">{{ product.title }}</h1>

        <!-- Rating summary & review anchor -->
        <div class="pdp-rating-row">
          <span class="pdp-stars">★★★★★</span>
          <span class="pdp-rating-count">(4.9/5 from verified tea lovers)</span>
        </div>

        <!-- Price Display -->
        <div class="pdp-price-wrapper" id="PdpPrice">
          {% render 'price', product: product, use_variant: current_variant, show_badges: false %}
          <span class="pdp-tax-note">Inclusive of all taxes &bull; Free delivery in India over ₹999</span>
        </div>

        <!-- Short Description -->
        {%- if product.description != blank -%}
          <div class="pdp-excerpt">
            {{ product.description | truncatewords: 35 }}
          </div>
        {%- endif -%}

        <!-- Add to Cart Form -->
        {%- form 'product', product, id: 'PdpForm', class: 'pdp-form', novalidate: 'novalidate' -%}
          <!-- Hidden Variant Input -->
          <input type="hidden" name="id" id="PdpVariantId" value="{{ current_variant.id }}">

          <!-- Variant Options (e.g. Pack Size / Weight) -->
          {%- unless product.has_only_default_variant -%}
            <div class="pdp-variant-options">
              {%- for option in product.options_with_values -%}
                <fieldset class="pdp-option-group">
                  <legend class="pdp-option-legend">
                    <span class="legend-name">{{ option.name }}:</span>
                    <span class="legend-val" id="OptionVal-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                  </legend>
                  <div class="pdp-option-pills">
                    {%- for value in option.values -%}
                      <label
                        class="pdp-pill-label{% if option.selected_value == value %} pdp-pill-label--active{% endif %}"
                        for="Option-{{ option.position }}-{{ forloop.index0 }}"
                      >
                        <input
                          type="radio"
                          id="Option-{{ option.position }}-{{ forloop.index0 }}"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          class="visually-hidden pdp-radio-input"
                          data-option-position="{{ option.position }}"
                          {% if option.selected_value == value %}checked="checked"{% endif %}
                        >
                        <span class="pdp-pill-text">{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Quantity Stepper & Stock Availability -->
          <div class="pdp-purchase-row">
            <div class="pdp-qty-stepper">
              <button type="button" class="qty-btn" id="QtyMinus" aria-label="Decrease quantity">-</button>
              <input
                type="number"
                name="quantity"
                id="PdpQuantity"
                class="qty-input"
                min="1"
                value="1"
                aria-label="Quantity"
              >
              <button type="button" class="qty-btn" id="QtyPlus" aria-label="Increase quantity">+</button>
            </div>

            <div class="pdp-stock-status">
              {%- if current_variant.available -%}
                <span class="stock-badge stock-badge--available">
                  <span class="stock-dot"></span> In Stock & Ready to Ship
                </span>
              {%- else -%}
                <span class="stock-badge stock-badge--unavailable">
                  Sold Out
                </span>
              {%- endif -%}
            </div>
          </div>

          <!-- Buttons -->
          <div class="pdp-buttons-group">
            <button
              type="submit"
              name="add"
              id="PdpAddToCartBtn"
              class="btn btn--primary pdp-add-to-cart-btn"
              {% unless current_variant.available %}disabled="disabled"{% endunless %}
            >
              <span>
                {%- if current_variant.available -%}
                  ADD TO CART &bull; <span id="PdpBtnPrice">{{ current_variant.price | money }}</span>
                {%- else -%}
                  SOLD OUT
                {%- endif -%}
              </span>
            </button>

            {%- if section.settings.show_dynamic_checkout and current_variant.available -%}
              <div class="pdp-dynamic-checkout">
                {{ form | payment_button }}
              </div>
            {%- endif -%}
          </div>
        {%- endform -%}

        <!-- Trust Features Grid -->
        <div class="pdp-trust-features">
          <div class="trust-feat">
            <span class="trust-icon">🌿</span>
            <div class="trust-text">
              <strong>100% Himalayan Harvest</strong>
              <span>Single origin, whole leaf only</span>
            </div>
          </div>
          <div class="trust-feat">
            <span class="trust-icon">⚡</span>
            <div class="trust-text">
              <strong>Express Delivery Across India</strong>
              <span>Dispatched within 24 hours</span>
            </div>
          </div>
          <div class="trust-feat">
            <span class="trust-icon">🛡️</span>
            <div class="trust-text">
              <strong>Secure Razorpay Checkout</strong>
              <span>UPI, RuPay, Netbanking, Cards</span>
            </div>
          </div>
        </div>

        <!-- Accordion Disclosures for Tea Details -->
        <div class="pdp-accordions">
          <!-- Tasting Notes & Terroir -->
          <details class="pdp-accordion-item" open>
            <summary class="pdp-accordion-trigger">
              <span>Tasting Profile & Botanical Origin</span>
              <span class="accordion-arrow">▾</span>
            </summary>
            <div class="pdp-accordion-content">
              {%- if product.metafields.custom.flavour_notes != blank -%}
                <p><strong>Flavor Notes:</strong> {{ product.metafields.custom.flavour_notes | join: ', ' }}</p>
              {%- endif -%}
              {%- if product.metafields.custom.tea_origin != blank -%}
                <p><strong>Estate Origin:</strong> {{ product.metafields.custom.tea_origin }}</p>
              {%- else -%}
                <p>Grown in micro-climate mist gardens in Darjeeling and Kangra Valley at 6,200ft altitude. Slow leaf maturation creates unmatched sweetness and ethereal floral notes.</p>
              {%- endif -%}
            </div>
          </details>

          <!-- Steeping Instructions -->
          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-trigger">
              <span>Master Brewing Parameters</span>
              <span class="accordion-arrow">▾</span>
            </summary>
            <div class="pdp-accordion-content">
              <div class="pdp-brewing-param-table">
                <div class="param-item">
                  <span class="param-label">Water Temp:</span>
                  <strong>{{ product.metafields.custom.brewing_temp | default: '85°C / 185°F' }}</strong>
                </div>
                <div class="param-item">
                  <span class="param-label">Steeping Time:</span>
                  <strong>{{ product.metafields.custom.brewing_time | default: '3 - 4 Minutes' }}</strong>
                </div>
                <div class="param-item">
                  <span class="param-label">Leaf Quantity:</span>
                  <strong>{{ product.metafields.custom.leaf_measurement | default: '2.5g per 200ml' }}</strong>
                </div>
              </div>
              <p class="param-tip">Tip: Use filtered mountain spring water for optimal clarity and umami sweetness.</p>
            </div>
          </details>

          <!-- Ingredients & Storage -->
          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-trigger">
              <span>Ingredients & Storage Advice</span>
              <span class="accordion-arrow">▾</span>
            </summary>
            <div class="pdp-accordion-content">
              <p><strong>Ingredients:</strong> {{ product.metafields.custom.tea_ingredients | default: '100% Certified Organic Whole Leaf Tea. No artificial flavourings or preservatives.' }}</p>
              <p><strong>Storage:</strong> Store sealed in this airtight UV-protective tin away from direct heat and moisture.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Embedded Variant Data for Fast Instant JS Switching -->
<script type="application/json" id="PdpVariantsJson-{{ section.id }}">
  {{ product.variants | json }}
</script>

{% stylesheet %}
  .main-product {
    background-color: var(--pdp-bg, var(--color-bg-primary));
    color: var(--pdp-text, var(--color-text));
    padding-top: var(--pdp-pt, 40px);
    padding-bottom: var(--pdp-pb, 80px);
  }
  .pdp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted, #4A6B5B);
    margin-bottom: 2rem;
  }
  .pdp-breadcrumb a {
    color: inherit;
    transition: color 0.2s ease;
  }
  .pdp-breadcrumb a:hover {
    color: var(--color-primary, #0C4A34);
  }
  .breadcrumb-current {
    color: var(--color-primary, #0C4A34);
    font-weight: 600;
  }
  .pdp-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 4.5rem;
    align-items: start;
  }

  /* Gallery Column */
  .pdp-gallery-sticky {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .pdp-main-image-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-bg-alternate, #EBF7EE);
  }
  .pdp-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .pdp-thumbnails-row {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  .pdp-thumb-btn {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 10px;
    border: 2px solid transparent;
    overflow: hidden;
    background-color: var(--color-bg-alternate);
    padding: 0;
    transition: border-color 0.2s ease;
    flex-shrink: 0;
  }
  .pdp-thumb-btn--active {
    border-color: var(--color-btn-bg, #00BFA5);
  }
  .pdp-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Details Column */
  .pdp-details-col {
    display: flex;
    flex-direction: column;
  }
  .pdp-vendor {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary, #059669);
    margin-bottom: 0.4rem;
  }
  .pdp-title {
    font-size: clamp(2.2rem, 3.5vw + 0.5rem, 3.2rem);
    color: var(--pdp-heading, var(--color-headings));
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }
  .pdp-rating-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
  }
  .pdp-stars {
    color: #F59E0B;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
  }
  .pdp-rating-count {
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
  .pdp-price-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(12, 74, 52, 0.1);
  }
  .pdp-price-wrapper .alpina-price {
    font-size: 1.7rem;
  }
  .pdp-tax-note {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .pdp-excerpt {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.8rem;
    color: var(--color-text-muted);
  }

  /* Variant Options Pills */
  .pdp-variant-options {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-bottom: 1.8rem;
  }
  .pdp-option-group {
    border: none;
    padding: 0;
    margin: 0;
  }
  .pdp-option-legend {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.6rem;
  }
  .legend-val {
    font-weight: 400;
    color: var(--color-text-muted);
    margin-left: 0.4rem;
  }
  .pdp-option-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .pdp-pill-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.4rem;
    background-color: #FFFFFF;
    border: 1.5px solid rgba(12, 74, 52, 0.18);
    border-radius: var(--radius-btn, 50px);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .pdp-pill-label:hover {
    border-color: var(--color-btn-bg, #00BFA5);
  }
  .pdp-pill-label--active {
    background-color: var(--color-primary, #0C4A34);
    border-color: var(--color-primary, #0C4A34);
    color: #FFFFFF;
  }

  /* Quantity & Stock */
  .pdp-purchase-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.8rem;
  }
  .pdp-qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid rgba(12, 74, 52, 0.18);
    border-radius: var(--radius-btn, 50px);
    background-color: #FFFFFF;
    overflow: hidden;
  }
  .qty-btn {
    width: 2.8rem;
    height: 2.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary);
    transition: background-color 0.2s ease;
  }
  .qty-btn:hover {
    background-color: rgba(12, 74, 52, 0.06);
  }
  .qty-input {
    width: 2.8rem;
    height: 2.8rem;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    -moz-appearance: textfield;
  }
  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .stock-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .stock-badge--available {
    color: var(--color-secondary, #059669);
  }
  .stock-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-secondary, #059669);
  }
  .stock-badge--unavailable {
    color: #C62828;
  }

  /* Buttons Group */
  .pdp-buttons-group {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
  }
  .pdp-add-to-cart-btn {
    width: 100%;
    padding: 1.05rem 2rem;
    font-size: 1.05rem;
  }
  .pdp-dynamic-checkout {
    width: 100%;
  }

  /* Trust Features */
  .pdp-trust-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    padding: 1.4rem;
    background-color: rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-card, 16px);
    border: 1px solid rgba(12, 74, 52, 0.1);
    margin-bottom: 2.5rem;
  }
  .trust-feat {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .trust-icon {
    font-size: 1.35rem;
  }
  .trust-text {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    line-height: 1.35;
  }
  .trust-text strong {
    color: var(--color-primary);
  }
  .trust-text span {
    color: var(--color-text-muted);
  }

  /* Accordions */
  .pdp-accordions {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .pdp-accordion-item {
    border: 1px solid rgba(12, 74, 52, 0.12);
    border-radius: 12px;
    background-color: #FFFFFF;
    overflow: hidden;
  }
  .pdp-accordion-trigger {
    padding: 1.1rem 1.4rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .pdp-accordion-trigger::-webkit-details-marker {
    display: none;
  }
  .accordion-arrow {
    font-size: 0.9rem;
    transition: transform 0.25s ease;
  }
  .pdp-accordion-item[open] .accordion-arrow {
    transform: rotate(180deg);
  }
  .pdp-accordion-content {
    padding: 0 1.4rem 1.25rem 1.4rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .pdp-brewing-param-table {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    background-color: var(--color-bg-primary);
    padding: 0.9rem;
    border-radius: 8px;
    margin-bottom: 0.8rem;
  }
  .param-item {
    display: flex;
    flex-direction: column;
    font-size: 0.82rem;
  }
  .param-label {
    color: var(--color-text-muted);
  }
  .param-item strong {
    color: var(--color-primary);
    font-size: 0.95rem;
  }
  .param-tip {
    font-size: 0.82rem;
    font-style: italic;
    margin: 0;
  }

  @media screen and (max-width: 1023px) {
    .pdp-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .pdp-gallery-sticky {
      position: static;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    // Thumbnail switching
    const mainImg = document.getElementById('PdpMainImage');
    const thumbBtns = document.querySelectorAll('[data-thumbnail-src]');

    thumbBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-thumbnail-src');
        if (mainImg && src) {
          mainImg.setAttribute('src', src);
          thumbBtns.forEach(b => b.classList.remove('pdp-thumb-btn--active'));
          btn.classList.add('pdp-thumb-btn--active');
        }
      });
    });

    // Quantity Stepper
    const qtyInput = document.getElementById('PdpQuantity');
    const minusBtn = document.getElementById('QtyMinus');
    const plusBtn = document.getElementById('QtyPlus');

    if (qtyInput && minusBtn && plusBtn) {
      minusBtn.addEventListener('click', () => {
        let val = parseInt(qtyInput.value, 10) || 1;
        if (val > 1) qtyInput.value = val - 1;
      });
      plusBtn.addEventListener('click', () => {
        let val = parseInt(qtyInput.value, 10) || 1;
        qtyInput.value = val + 1;
      });
    }

    // Interactive Variant Selection
    const variantsScript = document.querySelector('[id^="PdpVariantsJson-"]');
    if (!variantsScript) return;

    let variants = [];
    try {
      variants = JSON.parse(variantsScript.textContent);
    } catch (e) {
      console.error('Error parsing variants JSON', e);
      return;
    }

    const radios = document.querySelectorAll('.pdp-radio-input');
    const hiddenVariantId = document.getElementById('PdpVariantId');
    const addToCartBtn = document.getElementById('PdpAddToCartBtn');
    const btnPriceSpan = document.getElementById('PdpBtnPrice');

    function updateVariant() {
      const selectedOptions = [];
      const checkedRadios = document.querySelectorAll('.pdp-radio-input:checked');
      checkedRadios.forEach(r => {
        const pos = parseInt(r.getAttribute('data-option-position'), 10) - 1;
        selectedOptions[pos] = r.value;
      });

      // Update legend label text
      checkedRadios.forEach(r => {
        const pos = r.getAttribute('data-option-position') - 1;
        const legendVal = document.getElementById(`OptionVal-${pos}`);
        if (legendVal) legendVal.textContent = r.value;
        // Update active class on label
        document.querySelectorAll(`input[name="${r.name}"]`).forEach(inp => {
          inp.closest('.pdp-pill-label').classList.remove('pdp-pill-label--active');
        });
        r.closest('.pdp-pill-label').classList.add('pdp-pill-label--active');
      });

      // Match variant
      const matchedVariant = variants.find(v => {
        return v.options.every((opt, idx) => opt === selectedOptions[idx]);
      });

      if (matchedVariant) {
        if (hiddenVariantId) hiddenVariantId.value = matchedVariant.id;

        // Update URL state without page reload
        window.history.replaceState({}, '', `?variant=${matchedVariant.id}`);

        if (matchedVariant.available) {
          if (addToCartBtn) {
            addToCartBtn.removeAttribute('disabled');
            addToCartBtn.innerHTML = `<span>ADD TO CART &bull; ${formatMoney(matchedVariant.price)}</span>`;
          }
        } else {
          if (addToCartBtn) {
            addToCartBtn.setAttribute('disabled', 'disabled');
            addToCartBtn.innerHTML = '<span>SOLD OUT</span>';
          }
        }

        // Update featured image if variant has its own image
        if (matchedVariant.featured_image && matchedVariant.featured_image.src && mainImg) {
          mainImg.setAttribute('src', matchedVariant.featured_image.src);
        }
      }
    }

    radios.forEach(radio => radio.addEventListener('change', updateVariant));

    function formatMoney(cents) {
      return '₹' + (cents / 100).toLocaleString('en-IN');
    }
  });
{% endjavascript %}

