{%- liquid
  assign bg_color = section.settings.bg_color | default: 'var(--color-bg-primary)'
-%}

<section
  class="alpina-search-section full-width"
  style="
    --search-bg: {{ bg_color }};
    --search-pt: {{ section.settings.padding_top }}px;
    --search-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="alpina-container">
    <header class="search-header">
      <span class="section-eyebrow">DISCOVER BOTANICALS</span>
      <h1 class="search-title">Search Alpina Brew</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form-bar">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search organic teas, matcha, origins..."
          class="input-pill search-bar-input"
          aria-label="Search teas"
        >
        <button type="submit" class="btn btn--primary search-bar-submit" aria-label="Search">
          {% render 'icon', name: 'search' %}
          <span>SEARCH</span>
        </button>
      </form>

      <!-- Popular Tags / Quick Suggestions -->
      <div class="search-suggestions">
        <span class="suggestion-label">Popular Searches:</span>
        <a href="{{ routes.search_url }}?q=Matcha" class="suggestion-chip">Ceremonial Matcha</a>
        <a href="{{ routes.search_url }}?q=First+Flush" class="suggestion-chip">First Flush</a>
        <a href="{{ routes.search_url }}?q=Oolong" class="suggestion-chip">High Mountain Oolong</a>
        <a href="{{ routes.search_url }}?q=Himalayan" class="suggestion-chip">Himalayan Green</a>
      </div>
    </header>

    {%- if search.performed -%}
      <div class="search-status-bar">
        {%- if search.results_count == 0 -%}
          <p class="search-count-text">No results found for “<strong>{{ search.terms | escape }}</strong>”. Try another keyword or browse all teas.</p>
        {%- else -%}
          <p class="search-count-text">Found <strong>{{ search.results_count }}</strong> {{ search.results_count | pluralize: 'result', 'results' }} for “<strong>{{ search.terms | escape }}</strong>”:</p>
        {%- endif -%}
      </div>

      {%- if search.results_count > 0 -%}
        {%- paginate search.results by 12 -%}
          <div class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <!-- Article / Page Card -->
                <article class="alpina-card search-page-card">
                  <span class="page-badge">{{ item.object_type | upcase }}</span>
                  <h3 class="search-page-title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <p class="search-page-excerpt">{{ item.content | strip_html | truncatewords: 25 }}</p>
                  <a href="{{ item.url }}" class="search-page-link">Read more &rarr;</a>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="collection-pagination" aria-label="Pagination">
              {{ paginate | default_pagination }}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .alpina-search-section {
    background-color: var(--search-bg, var(--color-bg-primary));
    color: var(--color-text, #1B3B2B);
    padding-top: var(--search-pt, 40px);
    padding-bottom: var(--search-pb, 80px);
  }
  .search-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
  }
  .search-title {
    font-size: clamp(2.2rem, 3.5vw + 0.5rem, 3.2rem);
    color: var(--color-headings, #0C4A34);
    margin-bottom: 1.5rem;
  }
  .search-form-bar {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .search-bar-input {
    flex: 1;
    font-size: 1.05rem;
    padding: 0.95rem 1.6rem;
    background-color: #FFFFFF;
  }
  .search-bar-submit {
    padding: 0.95rem 1.8rem;
  }
  .search-suggestions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }
  .suggestion-label {
    color: var(--color-text-muted);
  }
  .suggestion-chip {
    padding: 0.25rem 0.8rem;
    background-color: rgba(12, 74, 52, 0.08);
    border-radius: 9999px;
    color: var(--color-primary);
    font-weight: 600;
    transition: background-color 0.2s ease;
  }
  .suggestion-chip:hover {
    background-color: var(--color-btn-bg, #00BFA5);
    color: #0C3827;
  }
  .search-status-bar {
    text-align: center;
    margin-bottom: 2.5rem;
    font-size: 1.1rem;
    color: var(--color-primary);
  }
  .search-page-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    background-color: #FFFFFF;
  }
  .page-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
  }
  .search-page-title a {
    color: var(--color-headings);
  }
  .search-page-excerpt {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    flex-grow: 1;
  }
  .search-page-link {
    font-weight: 700;
    color: var(--color-primary);
  }

  @media screen and (max-width: 640px) {
    .search-form-bar {
      flex-direction: column;
    }
    .search-bar-submit {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search Page",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#D4F1E0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ]
}
{% endschema %}
