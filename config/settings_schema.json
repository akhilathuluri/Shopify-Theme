  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Heading Font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n7",
        "label": "Heading font family"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 140,
        "step": 5,
        "unit": "%",
        "label": "Heading scale factor",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body Font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "Body font family"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body scale factor",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout & Geometry",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Maximum page width",
        "options": [
          { "value": "1200px", "label": "Compact (1200px)" },
          { "value": "1360px", "label": "Standard (1360px)" },
          { "value": "1440px", "label": "Wide (1440px)" }
        ],
        "default": "1360px"
      },
      {
        "type": "range",
        "id": "page_margin_desktop",
        "min": 16,
        "max": 64,
        "step": 4,
        "unit": "px",
        "label": "Desktop side padding",
        "default": 32
      },
      {
        "type": "range",
        "id": "page_margin_mobile",
        "min": 12,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Mobile side padding",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing_desktop",
        "min": 40,
        "max": 120,
        "step": 8,
        "unit": "px",
        "label": "Desktop vertical section spacing",
        "default": 80
      },
      {
        "type": "range",
        "id": "section_spacing_mobile",
        "min": 32,
        "max": 80,
        "step": 4,
        "unit": "px",
        "label": "Mobile vertical section spacing",
        "default": 48
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 50,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius (50px = Pill)",
        "default": 50
      },
      {
        "type": "range",
        "id": "input_radius",
        "min": 0,
        "max": 50,
        "step": 2,
        "unit": "px",
        "label": "Input field corner radius",
        "default": 50
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 16
      }
    ]
  },
  {
    "name": "Social Links",
    "settings": [
      {
        "type": "text",
        "id": "social_whatsapp",
        "label": "WhatsApp phone / chat link",
        "default": "https://wa.me/919876543210"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram handle or URL",
        "default": "https://instagram.com/alpinabrew"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook page URL",
        "default": "https://facebook.com/alpinabrew"
      }
    ]
  },
  {
    "name": "Store Policies & Currency",
    "settings": [
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold amount (INR)",
        "default": "999"
      },
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Enable AJAX slide-out cart drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_quick_add",
        "label": "Enable quick add to cart on product cards",
        "default": true
      }
    ]
  }
]
